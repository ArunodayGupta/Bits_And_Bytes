# ==============================================================================
# HealthSafe Environment Variables
# ==============================================================================

# Supabase Local or Hosted Project URL
# Local dev default: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Key (Public: Safe for browser client and read RPCs)
# Used by Node scripts and exposed to Vite frontend via VITE_ prefixed mirrors
SUPABASE_ANON_KEY=ey...

# Vite Browser Mirrors (Safe for browser)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=ey...

# Supabase Service Role Key (STRICTLY CONFIDENTIAL - SERVER & SCRIPTS ONLY)
# NEVER prefix with VITE_ or expose to browser code or commit to source control.
SUPABASE_SERVICE_ROLE_KEY=ey...

# Configurable Rx Token Namespace
RX_TOKEN_SYSTEM=https://phr-demo.example.org/rx-token
