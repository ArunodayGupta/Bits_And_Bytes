# ==============================================================================
# Unified Health Wallet - Backend Environment Variables
# ==============================================================================

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
RX_TOKEN_SYSTEM=https://phr-demo.example.org/rx-token

# Phase 2 OCR
OCR_PROVIDER=mock
OCR_ENABLED=true
OCR_MAX_UPLOAD_MB=5
OCR_DAILY_LIMIT=50
AWS_REGION=ap-south-1
