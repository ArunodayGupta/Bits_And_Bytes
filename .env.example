# ==============================================================================
# Unified Health Wallet Environment Variables (Phase 1 & Phase 2)
# ==============================================================================

# Supabase Local or Hosted Project URL
# Local dev default: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Key (Public: Safe for client and anonymous read RPCs)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (STRICTLY CONFIDENTIAL - SERVER & SEED SCRIPTS ONLY)
# NEVER prefix with VITE_ or expose to browser code or commit to source control.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Configurable Rx Token Namespace
RX_TOKEN_SYSTEM=https://phr-demo.example.org/rx-token

# ------------------------------------------------------------------------------
# Phase 2: OCR Scan-to-FHIR Configuration
# ------------------------------------------------------------------------------
# OCR Provider: 'mock' (default, zero credentials needed) or 'textract'
OCR_PROVIDER=mock

# OCR Feature Flag
OCR_ENABLED=true

# OCR Upload limit in Megabytes
OCR_MAX_UPLOAD_MB=5

# OCR Abuse Protection: Global daily scan cap
OCR_DAILY_LIMIT=50

# AWS Textract Configuration (Only used when OCR_PROVIDER=textract)
# Prefer AWS_PROFILE or the default AWS IAM instance credential chain
AWS_REGION=ap-south-1
# AWS_PROFILE=default

# Local dev placeholders (commented out, never required for mock provider)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ------------------------------------------------------------------------------
# Clerk Authentication Configuration (Optional - Google / Email SSO)
# ------------------------------------------------------------------------------
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
