{
  "name": "bits-and-bytes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend test && npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:integration": "npm --prefix backend run test:integration",
    "db:start": "npm --prefix backend run db:start",
    "db:reset": "npm --prefix backend run db:reset",
    "db:push": "npm --prefix backend run db:push",
    "db:types": "npm --prefix backend run db:types",
    "db:seed": "npm --prefix backend run db:seed",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix backend run typecheck",
    "check:secrets": "node scripts/check_secrets.js"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  }
}
